<!DOCTYPE html>
<html lang="pt-BR">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Conheça a Equipe</title>
    <link rel="stylesheet" href="/style.css">
</head>

<body>

    <!-- O header agora conterá apenas a navegação -->
    <header>
        <nav>
            <ul>
                <li><a href="index.html">Início</a></li>
                <li><a href="#">Projetos</a></li>
                <li><a href="#">Sobre</a></li>
                <li><a href="#">Contato</a></li>
            </ul>
        </nav>
    </header>

    <main>
        <!-- Movido o título da página para dentro do main -->
        <div class="page-title">
            <h1>Conheça a Equipe</h1>
            <p>Clique em um perfil para ver os projetos individuais.</p>
        </div>

        <section id="equipe">
        
            <%# Loop para criar um card para cada perfil %>
            <% if (typeof perfis !=='undefined' && perfis.length> 0) { %>
                <% perfis.forEach(function(perfil) { %>
        
                    <a href="/perfil/<%= perfil.id %>" class="perfil-link">
                        <article class="perfil">
                            <img src="<%= perfil.imagem %>" alt="Foto de <%= perfil.nome %>">
                            <h2><%= perfil.nome %></h2>
                            <p><%= perfil.cargo %></p>
                        </article>
                    </a>
  
                <% }); %>
            <% } else { %>
                <p>Nenhum perfil para exibir no momento.</p>                                
            <% } %>
        
        </section>

        <section id="cadastro">
            <a href="/cadastro" class="btn-principal">Cadastrar Pessoa</a>       
        </section>
        
    </main>

    <footer>
        <p>&copy; 2023 - Projeto de Portfólios</p>
    </footer>

    <script src="/main.js"></script>

</body>
</html>