<!-- views/cadastro.ejs -->

<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="stylesheet" href="/style.css">
    <title>Cadastrar Novo Perfil</title>
</head>
<body>
    <header>
        <nav>
            <a href="/">← Voltar para a equipe</a>
        </nav>
    </header>

    <main>
        <div class="form-container">
            <h1>Cadastrar Novo Perfil</h1>
            
            <!-- ESTE É O NOSSO FORMULÁRIO -->
            <!-- action="/cadastro" diz para onde enviar os dados -->
            <!-- method="POST" diz COMO enviar (de forma segura, não pela URL) -->
            <form action="/cadastro" method="POST">
                <div class="form-group">
                    <label for="nome">Nome Completo</label>
                    <input type="text" id="nome" name="nome" required>
                </div>

                <div class="form-group">
                    <label for="cargo">Cargo</label>
                    <input type="text" id="cargo" name="cargo" required>
                </div>

                <div class="form-group">
                    <label for="imagem">URL da Imagem</label>
                    <input type="text" id="imagem" name="imagem" placeholder="/imagens/novo-perfil.jpg">
                </div>
                
                <button type="submit" class="btn-submit">Cadastrar</button>
            </form>
        </div>
    </main>

    <footer>
        <p>&copy; 2023 - Projeto de Portfólios</p>
    </footer>

</body>
</html>